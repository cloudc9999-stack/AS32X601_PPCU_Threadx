    <peripheral>
      <name>SMU</name>
      <description>System Management Unit</description>
      <groupName>SMU</groupName>
      <baseAddress>0x30006000</baseAddress>
      <addressBlock>
        <offset>0x0</offset>
        <size>0x400</size>
        <usage>registers</usage>
      </addressBlock>
      <registers>
        <register>
          <name>PLLCFGR</name>
          <displayName>PLLCFGR</displayName>
          <description>PLL divide and reset configuration registers</description>
          <addressOffset>0x0</addressOffset>
          <size>0x20</size>
          <access>read-write</access>
          <resetValue>0x00E15A10</resetValue>
          <fields>
            <field>
              <name>PLLN</name>
              <description>Input frequency division control signal [5:0]</description>
              <bitOffset>0</bitOffset>
              <bitWidth>6</bitWidth>
            </field>
            <field>
              <name>PLLF</name>
              <description>Feedback clock control signal [8:0]</description>
              <bitOffset>6</bitOffset>
              <bitWidth>9</bitWidth>
            </field>
            <field>
              <name>PLLQ</name>
              <description>Output frequency division control signal of CLK_Q [3:0]</description>
              <bitOffset>15</bitOffset>
              <bitWidth>4</bitWidth>
            </field>
            <field>
              <name>PLLR</name>
              <description>Output frequency division control signal of CLK_R [2:0]</description>
              <bitOffset>19</bitOffset>
              <bitWidth>3</bitWidth>
            </field>
            <field>
              <name>PLLEN</name>
              <description>PLL clock enable</description>
              <bitOffset>22</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>PLLRST</name>
              <description>PLL clock reset signal</description>
              <bitOffset>23</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>PLLUF</name>
              <description>Update PLL frequency enable</description>
              <bitOffset>24</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>FIRCCFGR</name>
          <displayName>FIRCCFGR</displayName>
          <description>Internal clock and reset configuration registers</description>
          <addressOffset>0x4</addressOffset>
          <size>0x20</size>
          <access>read-write</access>
          <resetValue>0x00000020</resetValue>
          <fields>
            <field>
              <name>FIRCTF</name>
              <description>FIRC oscillator frequency adjustment [5:0]</description>
              <bitOffset>0</bitOffset>
              <bitWidth>6</bitWidth>
            </field>
            <field>
              <name>FIRCON</name>
              <description>FIRC oscillator switch</description>
              <bitOffset>6</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>FIRCRDY</name>
              <description>FIRC oscillator preparation position</description>
              <bitOffset>7</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>BUSCFGR</name>
          <displayName>BUSCFGR</displayName>
          <description>BUS clock and reset configuration registers</description>
          <addressOffset>0x8</addressOffset>
          <size>0x20</size>
          <access>read-write</access>
