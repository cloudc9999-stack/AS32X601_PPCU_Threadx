        <register>
          <name>CYCLES_SINCE_GO</name>
          <displayName>CYCLES_SINCE_GO</displayName>
          <description>PKA Cycles Since GO Register</description>
          <addressOffset>0x2C</addressOffset>
          <size>0x20</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <fields>
