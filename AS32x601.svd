              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>F2</name>
              <description>User flag 2</description>
              <bitOffset>6</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>F3</name>
              <description>User flag 3</description>
              <bitOffset>7</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
          </fields>
