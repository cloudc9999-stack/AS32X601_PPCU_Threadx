    </peripheral>
    <peripheral>
      <name>PKA</name>
      <description>Public Key Accelerator</description>
      <groupName>PKA</groupName>
      <baseAddress>0x41140000</baseAddress>
      <addressBlock>
        <offset>0x0</offset>
        <size>0x8000</size>
        <usage>registers</usage>
      </addressBlock>
      <registers>
        <register>
          <name>CTRL</name>
          <displayName>CTRL</displayName>
          <description>PKA Control Register</description>
          <addressOffset>0x0</addressOffset>
          <size>0x20</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <name>PARTIAL_RADIX</name>
              <description>Selects a partial field from within the base radix</description>
              <bitOffset>0</bitOffset>
              <bitWidth>8</bitWidth>
            </field>
            <field>
              <name>BASE_RADIX</name>
              <description>Sets the size of the base operand size (radix)</description>
              <bitOffset>8</bitOffset>
              <bitWidth>3</bitWidth>
            </field>
            <field>
              <name>M521_MODE</name>
              <description>Sets operating to Mersenne M-521</description>
              <bitOffset>16</bitOffset>
              <bitWidth>5</bitWidth>
            </field>
            <field>
              <name>STOP_RQST</name>
              <description>Requests PKA to halt at the next instruction boundary</description>
              <bitOffset>27</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>GO</name>
              <description>Starts the PKA execution</description>
              <bitOffset>31</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>ENTRY_PNT</name>
          <displayName>ENTRY_PNT</displayName>
          <description>PKA Program Entry Point Register</description>
          <addressOffset>0x4</addressOffset>
          <size>0x20</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <name>ADDR</name>
              <description>Program entry point</description>
              <bitOffset>0</bitOffset>
              <bitWidth>12</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>RTN_CODE</name>
          <displayName>RTN_CODE</displayName>
          <description>PKA Return Code Register</description>
          <addressOffset>0x8</addressOffset>
          <size>0x20</size>
          <access>read-only</access>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <name>STOP_REASON</name>
              <description>Indicates why the PKA stopped</description>
              <bitOffset>16</bitOffset>
              <bitWidth>8</bitWidth>
            </field>
            <field>
              <name>DPA_EN</name>
              <description>Indicates that the core is capable of operating in TA and/or DPA mode.</description>
              <bitOffset>27</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>ZERO</name>
              <description>Indicates the state of the zero flag in the sequencer</description>
              <bitOffset>28</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>IRQ</name>
              <description>Indicates when the PKA has completed its task</description>
              <bitOffset>30</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>BUSY</name>
              <description>Indicates that the PKA is actively executing a program</description>
              <bitOffset>31</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>INSTR_SINCE_GO</name>
          <displayName>INSTR_SINCE_GO</displayName>
          <description>PKA Instructions Since GO Register</description>
          <addressOffset>0x14</addressOffset>
          <size>0x20</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <name>INSTRS</name>
              <description>Number of instructions executed since the last GO command</description>
              <bitOffset>0</bitOffset>
              <bitWidth>32</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>CONFIG</name>
